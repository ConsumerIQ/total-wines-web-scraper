# --- Database target ---
# Local Postgres (docker-compose maps container 5432 -> host 5433):
DB_URL=postgresql+psycopg://scraper:scraper@localhost:5433/totalwine
#
# Supabase (staging): use the CONNECTION POOLER string from
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> "Session pooler".
# Format (note user is postgres.<project-ref>, and +psycopg for the driver):
#   DB_URL=postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (SSL is added automatically for non-local hosts.)

# New schema for scraped data (holds ALL retailers via a `source` column) —
# do NOT touch existing schemas.
DB_SCHEMA=retail_product_data

# Total Wine store to standardize pricing/availability on.
# Find a store id via the store locator; leave blank to let the spike discover one.
STORE_ID=

# Fetch behaviour
HEADLESS=true
# Comma-separated proxy URLs (leave blank until the Phase-0 spike says we need them)
# e.g. http://user:pass@host:port
PROXY_URLS=

# Politeness
REQUEST_DELAY_SECONDS=1.0
MAX_CONCURRENCY=4
